generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum BookingStatus {
  HELD
  PAYMENT_PENDING
  AWAITING_SHOP
  CONFIRMED
  ARRIVED
  IN_SERVICE
  COMPLETED
  EXPIRED
  FAILED
  CANCELLED
  REJECTED
  NO_SHOW
}
enum PaymentStatus {
  CREATED
  PAYMENT_PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum ShopKind {
  BARBER
  SALON
  PARLOUR
  SPA
  NAILS
  TATTOO
  PIERCING
}
/// Shop lifecycle (T3). Listings show ACTIVE only. CLOSED = partner account deleted or pending deletion.
enum ShopStatus {
  ACTIVE
  PAUSED
  CLOSED
}
enum WalkInStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}
model Partner {
  id String @id @default(cuid())
  phone String? @unique
  email String? @unique
  name String?
  passwordHash String?
  googleSub String? @unique
  pushToken String?
  /** T3: set when the owner asks to delete the account. Sign-in before + ACCOUNT_DELETION_GRACE_DAYS restores. */
  deletionRequestedAt DateTime?
  /** T3: set by the purge job once PII is blanked. Row is kept for finance/history links. */
  deletedAt DateTime?
  /** T3: JWT `tv` claim must match. Bumped when deletion is requested. */
  tokenVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops Shop[]
}
model User {
  id String @id @default(cuid())
  phone String? @unique
  email String? @unique
  name String?
  /** male | female | other | prefer_not — required before home. */
  gender String?
  /** Date of birth from the native picker. Must be 13+ on the day they sign up. */
  dateOfBirth DateTime? @db.Date
  /** Optional referral / invite code from onboarding. Not redeemed yet. */
  inviteCode String?
  passwordHash String?
  googleSub String? @unique
  /** True only after Google proves this address. Typed emails stay false (SEC-03). */
  emailVerified Boolean @default(false)
  pushToken String?
  /** T3: set when the owner asks to delete the account. Sign-in before + ACCOUNT_DELETION_GRACE_DAYS restores. */
  deletionRequestedAt DateTime?
  /** T3: set by the purge job once PII is blanked. Row is kept for finance/history links. */
  deletedAt DateTime?
  /** T3: JWT `tv` claim must match. Bumped when deletion is requested. */
  tokenVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings Booking[]
  favourites FavouriteShop[]
  reviews Review[]
  savedLocations SavedLocation[]
}
model SavedLocation {
  id String @id @default(cuid())
  userId String
  label String
  address String
  latitude Decimal
  longitude Decimal
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Shop {
  id String @id @default(cuid())
  name String
  address String
  city String
  /** Public shop contact (E.164). Customer shop page Contact dials this. */
  phone String?
  latitude Decimal
  longitude Decimal
  timezone String @default("Asia/Kolkata")
  /** @deprecated T3: use `status`. Kept in sync (isActive = status == ACTIVE) for one release, then dropped. */
  isActive Boolean @default(true)
  /** T3 lifecycle source of truth for listings. `acceptingAppointments` stays the day-to-day toggle. */
  status ShopStatus @default(ACTIVE)
  /** T3: set by the purge job when the owning partner is purged. CLOSED + null = closed, pending purge. */
  deletedAt DateTime?
  /** Partner Home toggle — false = closed on customer side (still listed). */
  acceptingAppointments Boolean @default(true)
  /** IST end of today’s hours — blocks new bookings for today only until this instant. */
  acceptingPausedUntil DateTime?
  ownerPartnerId String? @unique
  owner Partner? @relation(fields: [ownerPartnerId], references: [id])
  kind ShopKind?
  /** Multi-select shop types (home tiles). `kind` stays primary = kinds[0]. */
  kinds ShopKind[] @default([])
  /** Product brands used at the shop (setup + profile). */
  productBrands String[] @default([])
  chairCount Int @default(1)
  setupDone Boolean @default(false)
  amenities String[] @default([])
  dayCapacity ShopDayCapacity[]
  images ShopImage[]
  hours ShopWorkingHours[]
  barbers Barber[]
  services ShopService[]
  bookings Booking[]
  walkIns WalkIn[]
  favourites FavouriteShop[]
  reviews Review[]
  createdAt DateTime @default(now())
}
model ShopDayCapacity {
  id String @id @default(cuid())
  shopId String
  date String
  workersPresent Int
  chairsInUse Int
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, date])
}
model ShopImage {
  id String @id @default(cuid())
  shopId String
  url String
  sortOrder Int @default(0)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
model ShopWorkingHours {
  id String @id @default(cuid())
  shopId String
  weekday Int
  opensAt String
  closesAt String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, weekday])
}
model Barber {
  id String @id @default(cuid())
  shopId String
  name String
  rating Decimal @default(0)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  hours BarberWorkingHours[]
  breaks BarberBreak[]
  leaves BarberLeave[]
  bookings Booking[]
  walkIns WalkIn[]
  reviews Review[]
}
model BarberWorkingHours {
  id String @id @default(cuid())
  barberId String
  weekday Int
  opensAt String
  closesAt String
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  @@unique([barberId, weekday])
}
model BarberBreak {
  id String @id @default(cuid())
  barberId String
  startsAt DateTime
  endsAt DateTime
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  @@index([barberId, startsAt])
}
model BarberLeave {
  id String @id @default(cuid())
  barberId String
  startsAt DateTime
  endsAt DateTime
  reason String?
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  @@index([barberId, startsAt])
}
/** Global browse tiles (Ops catalogue). Ids match customer `SERVICE_CATEGORIES`. */
model ServiceCategory {
  id String @id
  label String
  gridLabel String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  services Service[]
}
model Service {
  id String @id @default(cuid())
  name String
  durationMinutes Int
  bufferMinutes Int @default(0)
  active Boolean @default(true)
  kind ShopKind?
  /** Ops-controlled tile placement (CJ-71). Null = unassigned → client “More”. */
  categoryId String?
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shops ShopService[]
  bookings BookingService[]
  @@index([categoryId])
}
model ShopService {
  shopId String
  serviceId String
  pricePaise Int
  /** Shop-level duration (overrides catalogue Service for this shop). */
  durationMinutes Int
  /** Shop-level turnover buffer after this line. */
  bufferMinutes Int @default(10)
  /// Who this line is for: MEN | WOMEN | KIDS | UNISEX (menu Men/Women/Kids filter).
  audience String @default("UNISEX")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([shopId, serviceId])
}
model Booking {
  id String @id @default(cuid())
  userId String
  shopId String
  barberId String
  startsAt DateTime
  endsAt DateTime
  status BookingStatus
  totalPaise Int
  advancePaise Int
  bookingCode String @unique
  /** 4-digit visit code (Rapido/Uber style) — customer shows, partner enters to start service. */
  verifyPin String?
  idempotencyKey String @unique
  /** Set when customer got “waiting time started” push at slot start. */
  waitingStartedNotifiedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])
  barber Barber @relation(fields: [barberId], references: [id])
  services BookingService[]
  payment BookingPayment?
  review Review?
  @@index([barberId, startsAt, endsAt])
  @@index([userId, createdAt])
  @@index([status, startsAt])
  /// T3: created CONCURRENTLY in 20261015000200.
  @@index([shopId, startsAt])
}
model BookingService {
  bookingId String
  serviceId String
  pricePaise Int
  durationMinutes Int
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
  @@id([bookingId, serviceId])
}
model BookingPayment {
  id String @id @default(cuid())
  bookingId String @unique
  provider String
  providerPaymentId String?
  /** Amount collected so far (advance and/or shop balance). */
  amountPaise Int
  status PaymentStatus
  /** Set when partner marks remaining balance paid at the chair. */
  shopSettledAt DateTime?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id])
}
model BookingHold {
  id String @id @default(cuid())
  userId String
  shopId String
  barberId String
  startsAt DateTime
  endsAt DateTime
  expiresAt DateTime
  idempotencyKey String @unique
  @@index([barberId, startsAt, expiresAt])
  /// T3: created CONCURRENTLY in 20261015000300.
  @@index([userId])
}
/** Partner floor walk-in — occupies a barber + chair like a booking (CJ-23). */
model WalkIn {
  id String @id @default(cuid())
  shopId String
  barberId String
  startsAt DateTime
  endsAt DateTime
  status WalkInStatus @default(ACTIVE)
  guestName String?
  note String?
  createdAt DateTime @default(now())
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  @@index([barberId, startsAt, endsAt])
  @@index([shopId, startsAt])
}
model FavouriteShop {
  userId String
  shopId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@id([userId, shopId])
}
model Review {
  id String @id @default(cuid())
  userId String
  shopId String
  barberId String
  bookingId String @unique
  /** Shop experience 1–5 (CJ-34). */
  rating Int
  /** Barber on that visit 1–5. */
  barberRating Int
  text String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])
  barber Barber @relation(fields: [barberId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])
  @@index([shopId, createdAt])
  @@index([barberId, createdAt])
}
model PhoneOtp {
  id String @id @default(cuid())
  phone String
  codeHash String
  /// #46: 'login' (POST /auth/otp/send) or 'reauth' (POST /auth/reauth/otp/send). A code only verifies for its own purpose.
  purpose String @default("login")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  /** JSON string: { bookingId?, screen? } for deep links / future coupons. */
  data      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/** Public Partner With Us form leads — ops email + durable inbox. */
model PartnerLead {
  id        String   @id @default(cuid())
  phone     String
  shopName  String?
  city      String?
  source    String   @default("partner-with-us")
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([phone, createdAt])
}

/// T3 abuse checks only (repeat no-shows, promo farming after delete + re-signup).
/// phoneHmac = HMAC-SHA256(PHONE_HASH_KEY, E.164 phone). Rows purged 12 months after deletedAt.
model DeletedIdentity {
  id        String   @id @default(cuid())
  phoneHmac String
  deletedAt DateTime @default(now())
  /** customer_deleted | partner_deleted */
  reason    String

  @@index([phoneHmac])
  @@index([deletedAt])
}

/// T3 one-time step-up grant (5 min) for destructive account actions. id = reauth JWT jti.
model ReauthGrant {
  id        String    @id
  subjectId String
  /** customer | partner */
  audience  String
  action    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Raw-SQL objects Prisma cannot express (drift notes; `prisma migrate diff` ignores them):
// - booking_barber_no_overlap / hold_barber_no_overlap EXCLUDE constraints (20261003154500)
// - User_email_lower_idx expression index (20261014020000)
// - T3 partial indexes: Shop_active_lat_lng_idx WHERE status = 'ACTIVE' (20261015000100),
//   User_purge_due_idx (20261015000400) and Partner_purge_due_idx (20261015000500)
//   WHERE "deletedAt" IS NULL AND "deletionRequestedAt" IS NOT NULL

{
  "expo": {
    "name": "CUTLY",
    "slug": "cutly",
    "owner": "zeus-pr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cutly-icon.png",
    "scheme": "cutly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cutly.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CUTLY uses your location to show nearby shops and set your area.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CUTLY uses your location to show nearby shops and set your area.",
        "NSLocationAlwaysUsageDescription": "CUTLY uses your location to show nearby shops and set your area."
      }
    },
    "android": {
      "package": "com.cutly.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F06B55"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CUTLY uses your location to show nearby shops and set your area.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ClashGrotesk-Regular.ttf",
            "./assets/fonts/ClashGrotesk-Medium.ttf",
            "./assets/fonts/ClashGrotesk-Semibold.ttf",
            "./assets/fonts/ClashGrotesk-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "CUTLY uses your photos on the shop page."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "resizeMode": "contain",
          "backgroundColor": "#F06B55"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#F06B55",
          "defaultChannel": "shop_requests_v2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e27cd70-adcb-44ae-a7b9-ae62568b79ad"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

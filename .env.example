API_BASE_URL=http://localhost:4000/api
# Device/LAN URLs belong in gitignored .env.local (Expo refuses personal vars in .env):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:4000/api
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api
# Prefer local Postgres for daily dev (fast). Neon Free US is fine for remote/prod-like checks;
# keep the Neon URL in a non-committed backup (e.g. .env.neon.bak) — never commit secrets.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/cutly
JWT_SECRET=
# Local CutLy Admin portal (admin/ on :5174). Required for /api/admin/*.
# Must be ≥24 chars and not a known weak default. Admin API is loopback-only.
# Generate: openssl rand -hex 32
ADMIN_SECRET=
GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# none = skip checkout (direct → awaiting shop). razorpay = test checkout when keys set.
PAYMENT_PROVIDER=none
# Comma-separated web origins (native apps send no Origin). Optional.
# CORS_ORIGINS=http://localhost:8081,https://cutly.buzz,http://localhost:5173
EXPO_PUBLIC_PAYMENTS_ENABLED=0
# Partner With Us leads → email (Resend). Lead still saves if key unset.
RESEND_API_KEY=
# Until cutly.buzz is verified in Resend, must be the Resend account email.
PARTNER_LEAD_TO=prajeshchoudhury42@gmail.com
RESEND_FROM=CutLy Leads <onboarding@resend.dev>
# Public marketing site (Cloudflare Pages project cutly-www). Redeploy: npm run site:deploy
PARTNER_SITE_URL=https://www.cutly.buzz
# App “Become a partner” opens this URL (defaults to www if unset).
EXPO_PUBLIC_PARTNER_SITE_URL=https://www.cutly.buzz
# Optional local/tunnel Host-gated fallback for site/dist (never api.cutly.buzz).
PARTNER_SITE_HOSTS=www.cutly.buzz,cutly.buzz
# Razorpay Test Mode (Dashboard → Test Mode → API Keys). Never commit real secrets.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
MAP_PROVIDER=none
MAP_API_KEY=
PUSH_NOTIFICATION_CONFIG=
# EAS project (also in app.json extra.eas.projectId) — needed for Expo push tokens
# Shared rate-limit buckets (SEC-20). Unset = in-memory on this process.
# Production: redis:// or rediss:// so limits survive restarts and extra API instances.
# Keys use a jittered TTL (window + up to 10%, max +60s), not one shared expiry.
# REDIS_URL=redis://127.0.0.1:6379
EXPO_PUBLIC_EAS_PROJECT_ID=9e27cd70-adcb-44ae-a7b9-ae62568b79ad
# T3 account deletion (#8). See docs/privacy-account-deletion.md.
# HMAC key for DeletedIdentity phone hashes (≥16 chars). Generate: openssl rand -hex 32
PHONE_HASH_KEY=
# ACCOUNT_DELETION_GRACE_DAYS=14
# DELETED_IDENTITY_RETENTION_DAYS=365
# Pending product calls (defaults shown):
# DELETION_FORMER_CUSTOMER_DURING_GRACE=1
# PARTNER_SELF_DELETE_ENABLED=1
# Optional: throwaway Postgres for tests/accountDeletion.db.test.ts (never a shared/prod DB)
# T3_TEST_DATABASE_URL=postgresql://user@127.0.0.1:5432/cutly_test
# T2 (#7) client IP + listeners.
# Bind address for :4000. Default 127.0.0.1 (cloudflared on this machine). 0.0.0.0 (Expo on a phone
# over LAN) is refused unless NODE_ENV=development; LAN peers are never trusted for CF-Connecting-IP.
# HOST=127.0.0.1
# Admin API listener, always bound to 127.0.0.1.
# ADMIN_PORT=4001
# Sockets allowed to set CF-Connecting-IP. Default loopback only. Invalid value = startup fails.
# Setting it REPLACES the loopback default (it does not add to it): include 127.0.0.1/32 and ::1/128 if you still want loopback trusted.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# HMAC key for PartnerLead.ipHash (falls back to PHONE_HASH_KEY). Generate: openssl rand -hex 32
IP_HASH_KEY=

# T4 (#9) email verification. Generate each key with: openssl rand -hex 32 (never commit real values).
EMAIL_CODE_KEY=
EMAIL_HASH_KEY=
# Transactional From (NE: must be exactly no-reply@notify.cutly.buzz once the Resend domain is verified).
EMAIL_FROM=CutLy <no-reply@notify.cutly.buzz>
# resend (default) | log  (log prints instead of sending; the code is shown only when NODE_ENV=development)
EMAIL_TRANSPORT=resend
# off (default) | on  (on = two-step email signup with a code; leave off until the app build ships)
SIGNUP_EMAIL_VERIFY=off
# Resend webhook signing secret (whsec_…) for POST /api/webhooks/resend (bounces / complaints).
RESEND_WEBHOOK_SECRET=

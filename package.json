{
  "name": "cutly",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "backend:dev": "tsx watch backend/src/main.ts",
    "backend:start": "tsx backend/src/main.ts",
    "api:ensure": "zsh scripts/cutly-api.sh ensure",
    "api:stop": "zsh scripts/cutly-api.sh stop",
    "api:status": "zsh scripts/cutly-api.sh status",
    "api:install-agent": "zsh scripts/install-cutly-api-launchagent.sh",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:deploy": "npm run site:build && npx wrangler pages deploy site/dist --project-name=cutly-www --branch=main --commit-dirty=true",
    "admin:dev": "zsh scripts/admin-dev.sh",
    "admin:ensure": "zsh scripts/cutly-admin.sh ensure",
    "admin:install-agent": "zsh scripts/install-cutly-admin-launchagent.sh",
    "admin:build": "npm --prefix admin run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "^1.0.16",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.87.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lottie-react-native": "~7.5.0",
    "moti": "^0.30.0",
    "motion": "^14.0.0",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "twilio": "^6.1.2",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@prisma/client": "^6.16.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "~19.3.0",
    "@ui-layouts/mcp": "^0.3.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
